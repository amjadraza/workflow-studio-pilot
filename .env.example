# Server-side settings. None of these are sent to the browser.

# The PIN everyone types (with their own name) to sign in. Required.
APP_PIN=

# Leave the key empty for replay mode (recorded outputs, no internet needed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Signs the login cookie. Set it to a long random string so people stay signed in when the server restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Morning media brief: the clock its daily trigger follows, and where schedules and briefs are saved.
BRIEF_TIMEZONE=Asia/Karachi
DATA_DIR=data
